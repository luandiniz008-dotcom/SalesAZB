# Conexão usada pelo app em runtime. Em serverless (Vercel) use a URL POOLED
# do seu Postgres — no Neon é o host com sufixo `-pooler`.
DATABASE_URL="postgresql://user:password@host-pooler.região.aws.neon.tech/dbname?sslmode=require"

# Conexão DIRETA (mesmo host, SEM `-pooler`). Usada só pelo `prisma migrate`
# (generate/deploy/dev), que precisa de advisory locks que o pooler não
# suporta — sem isso o build na Vercel falha com "P1002 ... advisory lock".
DIRECT_URL="postgresql://user:password@host.região.aws.neon.tech/dbname?sslmode=require"

# Chave usada pelo NextAuth para assinar sessões/JWT. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Domínio de e-mail aceito no cadastro de usuários
ALLOWED_EMAIL_DOMAIN="astrazeneca.com"
