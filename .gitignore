# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# skills de referência auto-instaladas pelo `prisma init` (documentação para
# assistentes de IA, não faz parte do app)
/.agents/
/.claude/skills/
/.windsurf/
/skills-lock.json

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# prévias temporárias de PDF
/_previa/
